# Copy to .env — that is the file the settings loader reads.
# Every value below is the built-in default from src/settings.py; uncomment only what you change.
# docker-compose overrides DATABASE_URL, REDIS_HOST, REDIS_PORT, TEMPORAL_HOST and PORT.

# --- Application ---------------------------------------------------------------
ENVIRONMENT=development
# APPLICATION_NAME=agent-orchestration-core
# APPLICATION_VERSION=1.0.0
# APPLICATION_DESCRIPTION=Agent Orchestration Core API
# HOST=0.0.0.0
# PORT=8010
# LOG_LEVEL=DEBUG
# EXPOSE_API_DOCS defaults to true only when ENVIRONMENT=development.
# EXPOSE_API_DOCS=false
# RELOAD=false

# --- Database ------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/agent_router

# --- Redis ---------------------------------------------------------------------
# REDIS_URL wins when set (it carries the database index); otherwise the client is
# composed from REDIS_HOST / REDIS_PORT / REDIS_DB.
# REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_SSL=false
# REDIS_DB=0
# REDIS_DEFAULT_TTL=3600
# CACHE_SILENT_MODE=true    # true swallows Redis errors; false fails hard
# DEFAULT_TTL=3600
# TURN_WINDOW_TTL=7200
# PERSONA_CACHE_TTL=1800
# DEDUP_TTL=86400

# --- Auth ----------------------------------------------------------------------
JWT_SECRET=change-me-for-local
JWT_ISSUER=dev-issuer
JWT_AUDIENCE=dev-audience
# JWT_ALGORITHM=HS256
# JWT_LEEWAY_SECONDS=0
# JWT_TENANT_TOKEN_EXPIRES_SECONDS=3600
# ADMIN_API_KEY=            # required by /admin/llm/* and /core/v1/auth/admin/api-keys (X-Admin-Key)
# PUBLIC_BASE_URL=          # base URL advertised in MCP server endpoints
# IDEMPOTENCY_TTL_SECONDS=3600

# --- LLM providers -------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_CONVERSATION_MODEL=gpt-4.1
# OPENAI_MODERATION_MODEL=omni-moderation-latest
# LLM_DEFAULT_MAX_LATENCY_MS=15000
# SLM_MODEL_PATH=models/Qwen2.5-1.5B-Instruct-GGUF
# SLM_INFERENCE_TIMEOUT_MS=500

# --- Embeddings and RAG --------------------------------------------------------
# EMBEDDING_DIMENSION=1536
# EMBEDDING_REQUEST_TIMEOUT_SECONDS=15
# EMBEDDING_MAX_RETRIES=2
# EMBEDDING_RETRY_BASE_DELAY_MS=200
# EMBEDDING_FALLBACK_MODEL=
# EMBEDDING_QUEUE_NAME=process_embedding_job
# EMBEDDING_QUEUE_MAX_ATTEMPTS=3
# MAX_USER_MEMORY_DOCUMENTS=10000

# --- Observability -------------------------------------------------------------
# TRACING_ENABLED=true      # set false to run with no telemetry at all
# METRICS_ENABLED=true
# LOGS_ENABLED=true         # exports log records to the collector for Loki
# OTEL_SERVICE_NAME=agent-orchestration-core
# OTEL_SERVICE_NAMESPACE=agent-orchestration
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_CAPTURE_CONTENT=false          # true exports prompts and completions
# OTEL_ATTRIBUTE_MAX_LENGTH=4096
# OTEL_SAMPLE_RATIO_DEFAULT=1.0
# OTEL_SAMPLE_RATIO_REPOSITORY=0.1    # repository spans are 176 of 300 instrumentation sites
# OTEL_METRIC_EXPORT_INTERVAL_MS=15000
# OTEL_FLUSH_TIMEOUT_MS=2000
# OTEL_SHUTDOWN_TIMEOUT_MS=10000

# --- Documents -----------------------------------------------------------------
# DOCUMENT_CONVERSION_TIMEOUT_SECONDS=120
# DOCLING_ENABLED=false     # requires `uv sync --extra docling` (multi-GB)
# USER_INPUT_COMPOSED_MAX_CHARS=1048576

# --- Runtime -------------------------------------------------------------------
# RUNTIME_LEGACY_GRAPH_CONTRACT_ENABLED=true
# Last-resort base URL for imported OpenAPI tools when the document has no
# `servers` entry and the fetch URL has no usable origin.
# TOOL_IMPORT_DEFAULT_BASE_URL=

# --- Durable execution (Temporal) ----------------------------------------------
# Off by default: flow runs execute inline in the HTTP request. Turn on together
# with `make temporal-up` and `make worker`.
TEMPORAL_ENABLED=false
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=flow-runs
# TEMPORAL_TLS=false
# TEMPORAL_API_KEY=
# TEMPORAL_FAIRNESS_ENABLED=false
# TEMPORAL_WORKER_MAX_CONCURRENT_ACTIVITIES=20
# TEMPORAL_WORKER_MAX_CONCURRENT_WORKFLOW_TASKS=50
# TEMPORAL_NODE_START_TO_CLOSE_TIMEOUT_MS=30000
# TEMPORAL_WORKFLOW_RUN_TIMEOUT_MS=120000
# TEMPORAL_TURN_WAIT_TIMEOUT_MS=125000
# TEMPORAL_TOOL_RUN_TASK_QUEUE=tool-runs
# TEMPORAL_TOOL_RUN_MAX_ATTEMPTS=3

# --- Flow-run reconciler (worker process) --------------------------------------
# Fails flow runs stranded between dispatch and finalization.
# FLOW_RUN_RECONCILER_ENABLED=true
# FLOW_RUN_RECONCILER_INTERVAL_SECONDS=60
# FLOW_RUN_RECONCILER_STALE_AFTER_SECONDS=900
# FLOW_RUN_RECONCILER_BATCH_SIZE=50

# --- Demo seed -----------------------------------------------------------------
# `make seed-demo` reads the vendored OpenAPI fixture and the bundled demo-api
# service, so it needs nothing external. Override only to point at your own API.
# DEMO_OPENAPI_URL=http://127.0.0.1:8088/openapi.json
# DEMO_API_HTTP_BASE=http://host.docker.internal:8088
# DEMO_OUTBOUND_API_KEY=demo-outbound-api-key-v1
