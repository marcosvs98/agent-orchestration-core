    {
        "created_by": "examples",
        "description": "Prompt for HumanFallback",
        "node_type": "HumanFallback",
        "output_schema": {
            "additionalProperties": false,
            "properties": {
                "new_priority": {
                    "type": "string"
                },
                "system_output": {
                    "type": "string"
                }
            },
            "required": [
                "system_output",
                "new_priority"
            ],
            "type": "object"
        },
        "template_text": "Classify the user message.\n\nhigh = system error blocking usage\nmedium = insults, aggression, anger, legal threats\nlow = frustration, cancellation or normal question\n\nNever downgrade priority.\n\nReply in English using this template:\n\"Your ticket is <ticket> and it will be resolved within <time>.\"\n\ntime:\nhigh = 4 hours\nmedium = 8 hours\nlow = 24 hours\n\nReturn only JSON:\n\n{\n  \"system_output\": \"...\",\n  \"new_priority\": \"high | medium | low\"\n}"
    },
    {
        "created_by": "examples",
        "description": "Prompt for MemoryCommitNode",
        "node_type": "MemoryCommitNode",
        "output_schema": null,
        "template_text": "Deterministic node. The node record requires a prompt reference; this text is never sent to an LLM."
    },
    {
        "created_by": "examples",
        "description": "Prompt for ResponseBuilder",
        "node_type": "ResponseBuilder",
        "output_schema": {
            "additionalProperties": false,
            "properties": {
                "operations_summary": {
                    "items": {
                        "additionalProperties": false,
                        "properties": {
                            "operation_id": {
                                "type": "string"
                            },
                            "status": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "operation_id",
                            "status"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                },
                "system_output": {
                    "type": "string"
                },
                "turn_status": {
                    "enum": [
                        "completed",
                        "partial_success",
                        "clarification_required",
                        "escalated",
                        "failed"
                    ],
                    "type": "string"
                }
            },
            "required": [
                "system_output",
                "operations_summary",
                "turn_status"
            ],
            "type": "object"
        },
        "template_text": "# Task\n{% if ctx.tool_response %}\nIf tool_response is present and non-empty: format it as a natural language message for the user in one concise sentence.\n{% endif %}\nIf tool_response is empty or absent: the user asked an informative question (e.g. how to do something). Answer using the retrieved context and user_input; be short and helpful.\nYou can use context from the previous conversation to complete slots.\n\n{% if ctx.input.input_payload.original_intent %}\n# Intent\n{{ ctx.input.input_payload.original_intent }}\n{% endif %}\n\n{% if ctx.tool_response %}\n# Tool Response\n{{ ctx.tool_response | tojson }}\n{% endif %}\n\n# Output Guidelines\n{% if ctx.tool_response %}\n- When tool_response is present: generate only one concise sentence; use product-oriented language; do not list fields or bullets; if success is true, confirm the expense was registered.\n{% endif %}\n- When tool_response is empty: answer the user question using the provided context; be concise.\n- Do not mention status codes, endpoints, requests, or payloads."
    },
    {
        "created_by": "examples",
        "description": "Prompt for IntentClassifier",
        "node_type": "IntentClassifier",
        "output_schema": {
            "additionalProperties": false,
            "properties": {
                "overall_confidence": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                },
                "result": {
                    "items": {
                        "additionalProperties": false,
                        "properties": {
