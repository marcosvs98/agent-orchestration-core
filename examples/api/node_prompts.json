                                "maximum": 1,
                                "minimum": 0,
                                "type": "number"
                            },
                            "intent_type": {
                                "enum": [
                                    "query",
                                    "command",
                                    "conversation",
                                    "update_user_preferences"
                                ],
                                "type": "string"
                            },
                            "priority": {
                                "minimum": 1,
                                "type": "integer"
                            }
                        },
                        "required": [
