[
    {
        "created_by": "examples",
        "description": "Prompt for ContentModeration",
        "node_type": "ContentModeration",
        "output_schema": {
            "additionalProperties": false,
            "properties": {
                "flagged": {
                    "type": "boolean"
                }
            },
            "required": [
                "flagged"
            ],
            "type": "object"
        },
        "template_text": "You are a moderation classifier.\nReturn JSON only.\n{\n \"flagged\": boolean\n}\n\nflagged = true if the text contains hate, harassment, sexual content,\nself harm, violence, or offensive language."
    },
    {
        "created_by": "examples",
        "description": "Prompt for ToolResolver",
        "node_type": "ToolResolver",
        "output_schema": {
            "additionalProperties": false,
            "properties": {
                "result": {
                    "items": {
                        "additionalProperties": false,
                        "properties": {
                            "confidence": {
                                "maximum": 1,
                                "minimum": 0,
                                "type": "number"
                            },
                            "intent_type": {
                                "enum": [
                                    "query",
                                    "command",
                                    "conversation"
                                ],
                                "type": "string"
                            },
                            "selected_tool": {
                                "additionalProperties": false,
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "tool_config_id": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "name",
                                    "tool_config_id"
                                ],
                                "type": "object"
                            }
                        },
                        "required": [
                            "intent_type",
                            "selected_tool",
                            "confidence"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                }
            },
            "required": [
                "result"
            ],
            "type": "object"
        },
        "template_text": "# Task\nSelect the best matching tool(s) for the user's intent. Return one entry per distinct intent.\n\n# Available tools\n{{ ctx.meta.available_tools | tojson }}\n\n# Intent-to-method mapping\n- When the user wants to CREATE, REGISTER, ADD, RECORD, or INSERT something new → prefer tools with method POST.\n- When the user wants to LIST, VIEW, SHOW, SEARCH, or CONSULT existing data → prefer tools with method GET.\n- Match the user's ACTION VERB to the correct HTTP method. Do NOT use a GET/list tool when the user clearly wants to create or register.\n\n# Constraints\n- selected_tool must reference a tool from available_tools by name and tool_config_id.\n- confidence between 0 and 1.\n- intent_type: \"query\" for GET tools, \"command\" for POST/PUT/PATCH/DELETE tools."
    },
    {
        "created_by": "examples",
        "description": "Prompt for ToolInputFiller",
        "node_type": "ToolInputFiller",
        "output_schema": {
            "additionalProperties": false,
            "properties": {
                "result": {
                    "items": {
                        "additionalProperties": false,
                        "properties": {
                            "blocking": {
                                "type": "boolean"
                            },
                            "depends_on": {
                                "items": {
                                    "type": "string"
                                },
                                "type": "array"
                            },
                            "missing_fields": {
                                "items": {
                                    "additionalProperties": false,
                                    "properties": {
                                        "field": {
                                            "type": "string"
                                        },
                                        "reason": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "field",
                                        "reason"
                                    ],
                                    "type": "object"
                                },
                                "type": "array"
                            },
                            "operation_id": {
                                "type": "string"
                            },
                            "params": {
                                "additionalProperties": false,
                                "properties": {},
                                "required": [],
                                "type": "object"
                            },
                            "status": {
                                "enum": [
                                    "ready",
                                    "incomplete"
                                ],
                                "type": "string"
                            },
                            "tool_name": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "operation_id",
                            "tool_name",
                            "status",
                            "params",
                            "missing_fields",
                            "depends_on",
                            "blocking"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                }
            },
            "required": [
                "result"
            ],
            "type": "object"
        },
        "template_text": "# Task\nExtract parameters from user input to fill the request schema.\nYou can use context from the previous conversation to complete slots.\n\n# Selected Tools\n{{ ctx.derived.selected_tools | tojson }}\n\n# Constraints\n- Use only names that appear in the request schema for `params` and for `missing_fields[].field`.\n- When the user’s wording clearly matches a field, fill it in the format the schema expects; do not add values or entities they did not convey.\n- `ready` when every required field in the schema is satisfied; otherwise `incomplete` and list only what is still missing.\n"
    },
    {
        "created_by": "examples",
        "description": "Prompt for QueryClarifier",
        "node_type": "QueryClarifier",
        "output_schema": {
            "additionalProperties": false,
            "properties": {
                "result": {
                    "items": {
                        "additionalProperties": false,
                        "properties": {
                            "missing_fields": {
                                "items": {
                                    "additionalProperties": false,
                                    "properties": {
                                        "field": {
                                            "type": "string"
                                        },
                                        "reason": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "field",
                                        "reason"
                                    ],
                                    "type": "object"
                                },
                                "type": "array"
                            },
                            "operation_id": {
                                "type": "string"
                            },
                            "tool_name": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "operation_id",
                            "tool_name",
                            "missing_fields"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                },
                "system_output": {
                    "type": "string"
                }
            },
            "required": [
                "system_output",
                "result"
            ],
            "type": "object"
        },
        "template_text": "# Task\nAsk the user for missing required information.\n\n# Intent\n{{ ctx.input.input_payload.intent | default('') }}\n\n# Missing Fields\n{{ ctx.derived.missing_fields | tojson }}\n\n# Constraints\n- Be concise and polite.\n- Ask only for missing fields.\n- Do not reference schemas or system internals.\n"
    },
