                            "confidence",
                            "priority"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                }
            },
            "required": [
                "result",
                "overall_confidence"
            ],
            "type": "object"
        },
        "template_text": "# Task\nClassify all user intents types and confidence."
    },
    {
        "created_by": "examples",
        "description": "Prompt for ContextSummarizer",
        "node_type": "ContextSummarizer",
        "output_schema": {
